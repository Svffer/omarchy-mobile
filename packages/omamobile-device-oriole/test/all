#!/bin/bash
# SPDX-License-Identifier: MIT
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT
./build "$t/build"
echo 'ok - reboot helper compiles'
./install "$t/root" "$t/build"
for file in usr/bin/reboot-to usr/bin/omamobile-setup-system \
  usr/lib/udev/rules.d/10-omamobile-storage.rules \
  usr/lib/systemd/network/20-usb-gadget.network \
  usr/lib/NetworkManager/conf.d/10-omamobile-usb.conf \
  usr/lib/systemd/sleep.conf.d/10-omamobile.conf usr/bin/omamobile-sleep \
  etc/UPower/UPower.conf.d/20-omamobile-critical-power.conf \
  usr/lib/modprobe.d/omamobile-oriole-bringup.conf \
  usr/lib/modprobe.d/omamobile-wifi.conf \
  usr/lib/modprobe.d/omamobile-bluetooth.conf \
  usr/bin/omamobile-bt-addr usr/bin/omamobile-wait-bluetooth \
  usr/lib/udev/rules.d/80-omamobile-bt-addr.rules \
  usr/lib/systemd/system/omamobile-bt-addr@.service \
  usr/lib/systemd/system/sddm.service.d/omamobile-oriole-bluetooth.conf \
  etc/pacman.d/omamobile-mirrorlist \
  usr/share/licenses/omamobile-device-oriole/LICENSE; do
  test -f "$t/root/$file"
done
test ! -d "$t/root/usr/lib/systemd/system/multi-user.target.wants"
if ./install / "$t/build" > "$t/refusal" 2>&1; then
  echo 'not ok - installation must refuse the host root' >&2
  exit 1
fi
echo 'ok - installation stages policy and helpers, with no enabled hardware services'

python3 - "$t/root/usr/lib/systemd/network/20-usb-gadget.network" <<'PY_ROUTE'
import configparser, sys
network = configparser.ConfigParser(strict=False)
network.read(sys.argv[1])
assert network['Match']['Name'] == 'usb0'
assert network['Network']['Address'] == '172.16.42.1/24'
assert 'Gateway' not in network['Network']
assert network['Route']['Gateway'] == '172.16.42.2'
assert int(network['Route']['Metric']) > 1024
print('ok - USB keeps its direct SSH address and a fallback route below Wi-Fi priority')
PY_ROUTE

python3 - "$t/root" <<'PY_POLICY'
from pathlib import Path
import sys
root = Path(sys.argv[1])
policy = (root/'usr/lib/modprobe.d/omamobile-oriole-bringup.conf').read_text().splitlines()
for module in ('gpio_max77759', 'arm_dsu_pmu', 'at24'):
    assert f'blacklist {module}' in policy
    assert f'install {module} /bin/false' in policy
# Suspend is s2idle (SUSPEND-PLAN S1-S4); nothing to hibernate to
sleep = (root/'usr/lib/systemd/sleep.conf.d/10-omamobile.conf').read_text().splitlines()
assert 'MemorySleepMode=s2idle' in sleep
assert 'AllowSuspend=no' not in sleep
for mode in ('Hibernation', 'SuspendThenHibernate', 'HybridSleep'):
    assert f'Allow{mode}=no' in sleep
assert (root/'usr/lib/systemd/system-sleep/omamobile').readlink() == Path('/usr/bin/omamobile-sleep')
# The only unit: the Bluetooth address, started by udev when hci0 appears
# (no unit is enabled at install; omamobile-setup-system is the gate)
assert sorted(p.name for p in root.rglob('*.service')) == ['omamobile-bt-addr@.service']
assert not list(root.rglob('*.wants'))
print('ok - coldplug refusals, s2idle sleep with its hook, and no enabled service units')
PY_POLICY

# Copied policy and helper must track the source package when present.
for file in src/reboot-to.c vendor/udev/rules.d/10-omamobile-storage.rules vendor/NetworkManager/conf.d/10-omamobile-usb.conf; do
  if [[ -f ../omamobile-device-cheetah/$file ]]; then
    cmp "$file" "../omamobile-device-cheetah/$file"
  fi
done
test ! -e "$t/root/usr/bin/omamobile-bootctl"

# The charger loads only with both options (raven's test): the input limit
# keeps charging on without a Type-C source, the guard follows the gauge
! grep -rqx 'blacklist max77759_charger' vendor/modprobe.d || fail "the charger is no longer blacklisted"
grep -qx 'options max77759_charger default_ilim_ua=500000 temp_guard=1' vendor/modprobe.d/omamobile-charger.conf \
  || fail "the charger loads with its input limit and the temperature guard"
grep -qx 'softdep max77759_charger pre: max17042_battery' vendor/modprobe.d/omamobile-charger.conf \
  || fail "the gauge loads before the charger"
test -x "$t/root/usr/bin/omamobile-charge-guard" || fail "omamobile-charge-guard is installed"
pass "the charger loads with its guard"

# The display stack loads at boot and offers the panel's 90 Hz (DISPLAY-PLAN D3-D6)
! grep -q '^options gs_decon max_refresh' vendor/modprobe.d/omamobile-oriole-display.conf \
  || fail "gs-decon is no longer capped below the S6E3FC3's 90 Hz"
pass "the display stack loads at boot with 90 Hz offered"
grep -qx 'options gs_dsim_cmd allow_tx=1' vendor/modprobe.d/omamobile-oriole-display.conf \
  || fail "the DSIM command path may send brightness to the panel"
test -f "$t/root/usr/lib/udev/rules.d/20-omamobile-display.rules" || fail "the display udev rules are installed"
pass "the DSIM sends DCS, the video group owns bl_power and the touch inhibit"

# Wi-Fi (WIFI-PLAN W5): the PCIe controller, PHY and brcmfmac load at boot;
# only the SysMMU DMA-window helper stays out (the pool confines brcmfmac)
for m in pcie_gs201 phy_gs201_pcie brcmfmac; do
  ! grep -qx "blacklist $m" vendor/modprobe.d/omamobile-wifi.conf || fail "$m is no longer blacklisted"
done
grep -qx 'blacklist pcie_gs201_sysmmu' vendor/modprobe.d/omamobile-wifi.conf || fail "the PCIe SysMMU helper stays out"
pass "the Wi-Fi PCIe stack loads at boot without the SysMMU helper"

# Bluetooth (BLUETOOTH-PLAN): the patch streams without waiting on Write RAM,
# the bootloader's address is set when the controller appears, and the session
# waits for the adapter (raven's helpers)
grep -qx 'options btbcm patchram_nowait=1' vendor/modprobe.d/omamobile-bluetooth.conf \
  || fail "btbcm streams the patch"
grep -q 'DRIVERS=="hci_uart_bcm"' vendor/udev/rules.d/80-omamobile-bt-addr.rules || fail "the address rule matches hci_uart_bcm"
grep -q 'ENV{DEVTYPE}=="host"' vendor/udev/rules.d/80-omamobile-bt-addr.rules || fail "the address rule skips connection nodes"
grep -q 'ExecStartPre=-/usr/bin/omamobile-wait-bluetooth' vendor/systemd/system/sddm.service.d/omamobile-oriole-bluetooth.conf \
  || fail "sddm waits for the adapter"
bash -n bin/omamobile-bt-addr && bash -n bin/omamobile-wait-bluetooth || fail "the Bluetooth helpers parse"
pass "Bluetooth: patch streaming, the bootloader's address, the session waits for the adapter"
