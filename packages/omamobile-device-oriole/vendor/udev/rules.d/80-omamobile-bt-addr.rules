# SPDX-License-Identifier: MIT
# Omarchy Mobile: give the BCM4389 Bluetooth controller its real address
# (omamobile-bt-addr@.service). Hosts only: a connection (hci0:11,
# DEVTYPE=link) matched too and its unit failed (2026-11-08).
ACTION=="add", SUBSYSTEM=="bluetooth", ENV{DEVTYPE}=="host", KERNEL=="hci[0-9]*", DRIVERS=="hci_uart_bcm", TAG+="systemd", ENV{SYSTEMD_WANTS}+="omamobile-bt-addr@%k.service"
