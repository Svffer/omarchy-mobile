# SPDX-License-Identifier: MIT
# The panel's backlight: the video group (the logged-in user) may switch the
# panel off and on through bl_power, which Omarchy's display off/on uses
# (patches/omarchy/0008-*). Brightness itself goes through logind. As raven's.
ACTION=="add", SUBSYSTEM=="backlight", KERNEL=="1c2c0000.dsi.0", RUN+="/usr/bin/chgrp video /sys%p/bl_power", RUN+="/usr/bin/chmod g+w /sys%p/bl_power"
# The touchscreen (ST FTS, input name "fts"): the video group may inhibit it,
# so Omarchy's display off makes a dark screen ignore touch.
ACTION=="add", SUBSYSTEM=="input", KERNEL=="input*", ATTR{name}=="fts", RUN+="/usr/bin/chgrp video /sys%p/inhibited", RUN+="/usr/bin/chmod g+w /sys%p/inhibited"
