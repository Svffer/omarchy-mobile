# SPDX-License-Identifier: MIT
# Oriole-only kernel options, merged after kernel/configs/omamobile.config.
# merge_config only warns about a symbol a kernel doesn't have, so the
# published kernel still builds when a driver lives on an unpublished
# branch. The Pixel 6 shares these blocks with the Pixel 6 Pro
# (device/raven/kernel.config; NOTES.md 2026-11-08: the stock kernel binds
# the same AoC, S5123 modem, CS40L25A haptics and ACPM thermal sensors).
# Oriole's own panel (Samsung S6E3FC3) and touch controller (ST FTS on
# SPI11) have no driver in the tree yet; they are added here once they do.
# The AoC drivers against gs101's firmware interface (raven's AUDIO-PLAN R0).
CONFIG_GOOGLE_AOC_GS101=y
# The modem (S5123) takes its first boot stage over SPI bus 9 before its PCIe
# link (raven's MODEM-PLAN section 2; the same "cpboot_spi ... bus_num:9" on
# oriole's stock kernel).
CONFIG_BOOT_DEVICE_SPI=m
# The gs101 thermal sensors through ACPM and the CS40L25A haptics, as modules.
CONFIG_GS101_ACPM_THERMAL=m
CONFIG_INPUT_CS40L25_VIBRA=m

# The ST FTS (FTM5) touch controller on SPI11, Google's driver as a
# bring-up module (device/oriole/TOUCH-PLAN.md, kernel branch oriole-touch).
CONFIG_TOUCHSCREEN_ST_FTS_V521_SPI=m

# Bluetooth RFCOMM, for the headset profiles (HFP/HSP): without it bluez
# can't open the Hands-Free gateway ("socket(STREAM, RFCOMM): Protocol not
# supported", SUSPEND-PLAN 2026-11-08) and only A2DP works.
CONFIG_BT_RFCOMM=m
